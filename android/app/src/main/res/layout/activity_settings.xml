<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Título do Ecrã no azul da marca SANA -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Configuração do Servidor API"
        android:textColor="#0052CC"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="20dp" />

    <!-- Card do Formulário de Configuração -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Endereço IP do Servidor:"
                android:textColor="#1A2B4C"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etServerIp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Ex: 192.168.1.100"
                android:textColorHint="#707D93"
                android:inputType="text"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Porta do Servidor:"
                android:textColor="#1A2B4C"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etServerPort"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Ex: 8080"
                android:textColorHint="#707D93"
                android:inputType="number"
                android:layout_marginBottom="24dp" />

            <!-- Botão Guardar no azul SANA -->
            <Button
                android:id="@+id/btnSave"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Guardar Configurações"
                android:backgroundTint="#0052CC"
                android:textColor="#FFFFFF"
                android:padding="14dp" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>