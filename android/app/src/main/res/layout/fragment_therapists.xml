<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Título do Ecrã no azul SANA -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pesquisar Terapeutas"
        android:textColor="#0052CC"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="20dp" />

    <!-- Card da Barra de Pesquisa -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp">

        <EditText
            android:id="@+id/etSearchTherapist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Filtrar por nome ou especialidade..."
            android:textColorHint="#707D93"
            android:textColor="#1A2B4C"
            android:background="@android:color/transparent"
            android:drawableLeft="@android:drawable/ic_menu_search"
            android:drawablePadding="12dp"
            android:padding="16dp" />
    </androidx.cardview.widget.CardView>

    <!-- Lista Recycler com elevação visual -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvTherapists"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false" />
</LinearLayout>